shell-integration = fish


theme = One Half Light
font-family = "Monaspace Neon NF"
font-size = 14

window-decoration = none
cursor-style = block
shell-integration-features = no-cursor

# `super` maps to Cmd on macOS and Super on Linux; `cmd` is macOS-only.
keybind = super+enter=unbind
# macOS-only; a known config key on all platforms, ignored off macOS.
macos-option-as-alt = true

